classDiagram
    class FaceDetector {
      +process(frame) FaceLandmarks[]
      +close()
    }
    class FaceLandmarks {
      +points
      +bbox
    }
    class DrowsinessMonitor {
      +update(ear, mar) DrowsinessStatus
      +reset()
      -ear_history
      -mar_history
    }
    class AlertManager {
      +trigger(frame, message)
    }
    FaceDetector --> FaceLandmarks
    DrowsinessMonitor --> DrowsinessStatus
    Main --> FaceDetector
    Main --> DrowsinessMonitor
    Main --> AlertManager
