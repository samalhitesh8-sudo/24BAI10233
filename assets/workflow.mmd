flowchart TD
    A([Start]) --> B[Open camera or video]
    B --> C{Frame available?}
    C -- No --> Z([Stop])
    C -- Yes --> D[Detect face landmarks]
    D --> E{Face found?}
    E -- No --> F[Display No face detected]
    E -- Yes --> G[Calculate EAR and MAR]
    G --> H[Update rolling counters]
    H --> I{Drowsiness threshold reached?}
    I -- No --> J[Display ALERT or ATTENTION]
    I -- Yes --> K[Display warning and beep]
    F --> L{Quit key?}
    J --> L
    K --> L
    L -- No --> C
    L -- Yes --> Z
